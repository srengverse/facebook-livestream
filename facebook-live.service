[Unit]
Description=Facebook Live Streaming Platform
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/facebook-live
EnvironmentFile=/home/ubuntu/facebook-live/.env
ExecStart=/usr/bin/gunicorn --workers 4 --bind 0.0.0.0:5000 app:app
Restart=always

[Install]
WantedBy=multi-user.target

# Application security: generate independent high-entropy values, for example:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_random_value_at_least_32_characters_long
DESTINATION_ENCRYPTION_KEY=replace_with_a_second_random_value_at_least_32_characters_long
# Set true only when the app is served through HTTPS; use false for direct HTTP development.
SESSION_COOKIE_SECURE=false

# Administrator login
ADMIN_USERNAME=admin
# Prefer a Werkzeug password hash. Create one with:
# python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('change-me'))"
ADMIN_PASSWORD=replace_with_a_secure_password_or_werkzeug_hash

# Facebook Page (can also be entered securely through the application UI)
PAGE_ACCESS_TOKEN=your_page_access_token_here
PAGE_ID=your_page_id_here
FACEBOOK_GRAPH_API_VERSION=v20.0
FACEBOOK_API_TIMEOUT=15
STREAM_TITLE=My Live Stream
STREAM_DESCRIPTION=Streaming from my custom platform

# Runtime
VIDEO_PATH=uploads/
UPLOAD_FOLDER=uploads/
LOG_PATH=logs/
DATABASE_URL=sqlite:///database.db
PORT=5000
DEBUG=False
